# =============================================================================
# DRCP Web App Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# cp env.example .env.local

# =============================================================================
# REQUIRED
# =============================================================================

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Active Chain: "lisk-sepolia" | "amoy" | "polygon"
NEXT_PUBLIC_CHAIN=lisk-sepolia

# =============================================================================
# OPTIONAL (has defaults)
# =============================================================================

# The Graph Subgraph URL (for indexing)
# Default: https://api.studio.thegraph.com/query/1721760/drcp-polygon-amoy/v0.0.7
NEXT_PUBLIC_SUBGRAPH_URL=

# Custom RPC URL (if you want to use your own)
# Default: Uses public RPC for selected chain
NEXT_PUBLIC_RPC_URL=

# AI Engine URL (for disaster prediction - optional feature)
# Default: http://localhost:8000
NEXT_PUBLIC_AI_ENGINE_URL=

# Chain ID (for EIP-712 signatures)
# Default: 4202 (Lisk Sepolia) or 80002 (Amoy)
NEXT_PUBLIC_CHAIN_ID=4202
