# ===========================================
# DRCP Root .gitignore
# ===========================================

# Environment files (ALL subfolders)
.env
.env.local
.env.*.local
*.env
**/.env
**/.env.local

# Private keys & secrets
.secret
**/secrets/
*.pem
*.key

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
.next/
out/

# Hardhat (contracts)
contracts/cache/
contracts/artifacts/
contracts/typechain-types/

# Subgraph
subgraph/build/
subgraph/generated/

# Mobile app
mobile-app/.expo/
mobile-app/android/
mobile-app/ios/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage
coverage/
.nyc_output/

# Misc
*.tsbuildinfo
.turbo/
